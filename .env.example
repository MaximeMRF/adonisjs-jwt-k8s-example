# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Kubernetes ServiceAccount tokens. The defaults work from inside a kubeadm
# or k3s cluster; set K8S_ISSUER to your cluster's issuer otherwise:
# kubectl get --raw /.well-known/openid-configuration
# K8S_JWKS_URI=https://kubernetes.default.svc/openid/v1/jwks
# K8S_ISSUER=https://kubernetes.default.svc.cluster.local
# K8S_AUDIENCE=my-api
# K8S_SA_DIR=/var/run/secrets/kubernetes.io/serviceaccount
